# Copy this file to .env and fill in your local paths.
# .env is gitignored and never committed.

# Path to your Obsidian vault (the folder containing the Wiki/ subdirectory)
VAULT_PATH=/path/to/your/obsidian/vault

# Path to your Excalidraw drawings folder (optional — leave blank to disable)
EXCALIDRAW_DIR=/path/to/your/Excalidraw

# Server port (default: 3000)
PORT=3000

# ── Flipbook (generative pixel UI) ────────────────────────────────────────────
# The Flipbook UI is rendered locally as SVG from vault graph data. It does not
# require an image model. Keep provider local unless you add an optional AI
# enhancer later.
FLIPBOOK_PROVIDER=local-svg

# Optional future enhancer key (not required for the base Flipbook UI).
# FAL_KEY=your-fal-key
